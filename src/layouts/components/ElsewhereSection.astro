---
import { getEntry } from 'astro:content';

const settings = await getEntry('settings', 'site');
const links = settings?.data.socialLinks ?? [];
---

<section id="elsewhere" class="elsewhere">
  <h2>Elsewhere</h2>
  <div class="elsewhere-tags">
    {
      links.map((link) => (
        <a href={link.url} class={`tag tag-${link.style === 'accent-2' ? 'accent-2' : 'outline'}`}>
          {link.label}
        </a>
      ))
    }
  </div>
</section>

<style>
  .elsewhere {
    padding: var(--space-6) 0 var(--space-8);
  }
  .elsewhere h2 {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 600;
    margin: 0 0 var(--space-4);
  }
  .elsewhere-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .elsewhere-tags a {
    text-decoration: none;
  }
</style>
