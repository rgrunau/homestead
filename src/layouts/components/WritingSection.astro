---
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function teaser(post: (typeof posts)[number]) {
  if (post.data.summary) return post.data.summary;
  const words = post.body?.trim().split(/\s+/).slice(0, 100).join(' ') ?? '';
  return words;
}

function dateLabel(post: (typeof posts)[number]) {
  const month = post.data.date.toLocaleString('en-US', {
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
  return `Published — ${month}`;
}
---

{
  posts.length > 0 && (
    <section id="writing" class="writing">
      <div class="writing-heading">
        <h2>Writing</h2>
        <span class="writing-kicker">occasional, unscheduled</span>
      </div>

      {posts.map((post) => (
        <article class="writing-post">
          <div class="writing-date">{dateLabel(post)}</div>
          <h3>
            <a href={`/posts/${post.id}/`}>{post.data.title}</a>
          </h3>
          <p>{teaser(post)}</p>
          <a href={`/posts/${post.id}/`} class="writing-link">
            Read the post →
          </a>
        </article>
      ))}
    </section>
  )
}

<style>
  .writing {
    padding: var(--space-6) 0;
  }
  .writing-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--space-4);
  }
  .writing-heading h2 {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 600;
    margin: 0;
  }
  .writing-kicker {
    font-size: 13px;
    font-style: italic;
    color: var(--color-neutral-700);
  }
  .writing-post {
    padding-bottom: var(--space-4);
  }
  .writing-date {
    font-size: 13px;
    color: var(--color-neutral-700);
    margin-bottom: var(--space-2);
  }
  .writing-post h3 {
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 600;
    margin: 0 0 var(--space-3);
  }
  .writing-post h3 a {
    color: var(--color-text);
    text-decoration: none;
  }
  .writing-post h3 a:hover {
    color: var(--color-accent);
  }
  .writing-post p {
    font-size: 16px;
    line-height: 1.65;
    color: var(--color-neutral-800);
    margin: 0 0 var(--space-3);
    max-width: 60ch;
  }
  .writing-link {
    font-size: 15px;
  }
</style>
