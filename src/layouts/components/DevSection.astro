---
import { getCollection, getEntry } from 'astro:content';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const settings = await getEntry('settings', 'site');
const devIntro = settings?.data.devIntro;
---

<section id="dev" class="dev">
  <h2>Dev Work</h2>
  {devIntro && <p class="dev-intro">{devIntro}</p>}

  <div class="dev-list">
    {
      projects.map((project) => (
        <article class="dev-project">
          <div class="dev-screenshot halftone">
            {project.data.screenshot ? (
              <img src={project.data.screenshot} alt={project.data.title} />
            ) : (
              <span class="dev-screenshot-placeholder">Screenshot</span>
            )}
          </div>
          <div>
            <h3>{project.data.title}</h3>
            <p>{project.data.description}</p>
            <a href={project.data.link} class="dev-link">
              View project →
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .dev {
    padding: var(--space-6) 0;
  }
  .dev h2 {
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 600;
    margin: 0 0 var(--space-4);
  }
  .dev h2:has(+ .dev-intro) {
    margin-bottom: var(--space-2);
  }
  .dev-intro {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-neutral-800);
    max-width: 60ch;
    margin: 0 0 var(--space-4);
  }
  .dev-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .dev-project {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--space-4);
    align-items: start;
  }
  .dev-screenshot {
    width: 160px;
    height: 110px;
    border-radius: var(--radius-lg);
    border: 1px dashed var(--color-divider);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
  }
  .dev-screenshot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .dev-screenshot-placeholder {
    font-size: 12px;
    color: var(--color-neutral-600);
  }
  .dev-project h3 {
    font-family: var(--font-heading);
    font-size: 19px;
    font-weight: 600;
    margin: 0 0 var(--space-2);
  }
  .dev-project p {
    font-size: 15px;
    line-height: 1.6;
    color: var(--color-neutral-800);
    margin: 0 0 var(--space-2);
    max-width: 55ch;
  }
  .dev-link {
    font-size: 14px;
  }

  @media (max-width: 520px) {
    .dev-project {
      grid-template-columns: 1fr;
    }
    .dev-screenshot {
      width: 100%;
    }
  }
</style>
