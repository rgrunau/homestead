---
import { getEntry, render } from 'astro:content';

const settings = await getEntry('settings', 'site');
const { Content } = settings ? await render(settings) : { Content: null };
---

<section id="top" class="hero">
  <h1>{settings?.data.heroTitle}</h1>
  <div class="hero-body">{Content && <Content />}</div>
</section>

<style>
  .hero {
    padding: var(--space-6) 0 var(--space-8);
  }
  .hero h1 {
    font-family: var(--font-heading);
    font-size: 44px;
    line-height: 1.15;
    font-weight: 600;
    margin: 0 0 var(--space-4);
  }
  .hero-body :global(p) {
    font-size: 18px;
    line-height: 1.65;
    max-width: 62ch;
    margin: 0 0 var(--space-4);
  }
  .hero-body :global(p:last-child) {
    margin: 0;
  }
</style>
