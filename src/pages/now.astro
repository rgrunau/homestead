---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const now = await getEntry('now', 'now');
const sections = now?.data.sections ?? [];
const dateLabel = now?.data.date.toLocaleString('en-US', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title="Now — Robert Grunau">
  <div class="now-container">
    <nav class="now-nav">
      <a href="/">← Back home</a>
    </nav>

    <article class="now-article">
      <h1>Now</h1>
      {dateLabel && <p class="now-updated">Updated — {dateLabel}</p>}

      {
        sections.map((section) => (
          <section class="now-section">
            <h2>{section.label}</h2>
            <ul>
              {section.entries.map((entry) => (
                <li>
                  {entry.url ? <a href={entry.url}>{entry.text}</a> : entry.text}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </article>

    <footer class="now-footer">
      <a href="/">← Back home</a>
    </footer>
  </div>
</BaseLayout>

<style>
  .now-container {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 var(--space-6) var(--space-8);
    font-family: var(--font-body);
    color: var(--color-text);
  }
  .now-nav {
    padding: var(--space-6) 0;
  }
  .now-nav a {
    text-decoration: none;
    font-size: 14px;
    color: var(--color-neutral-700);
  }
  .now-article {
    padding-bottom: var(--space-8);
  }
  .now-article h1 {
    font-family: var(--font-heading);
    font-size: 36px;
    line-height: 1.2;
    font-weight: 600;
    margin: 0 0 var(--space-2);
  }
  .now-updated {
    font-size: 13px;
    color: var(--color-neutral-700);
    margin: 0 0 var(--space-6);
  }
  .now-section {
    margin-bottom: var(--space-6);
  }
  .now-section h2 {
    font-family: var(--font-heading);
    font-size: 20px;
    font-weight: 600;
    margin: 0 0 var(--space-3);
  }
  .now-section ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .now-section li {
    font-size: 17px;
    line-height: 1.6;
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-divider);
  }
  .now-section li:last-child {
    border-bottom: none;
  }
  .now-footer {
    padding: var(--space-6) 0;
    font-size: 13px;
    color: var(--color-neutral-700);
  }
</style>
